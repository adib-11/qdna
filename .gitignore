# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# working material — planning docs, design references, and source exam papers
# stay local; the public repo carries the project only
/plan/
/UI/
/PROJECT_DOC.md
/Challenge_*.md
/AGENTS.md
/CLAUDE.md
*.pdf

# extraction cache for scripts/extract-corpus.mjs — resumable, machine-local
/.cache/

# hackathon submission plugin state — local tooling, not project code
/.devpost-hackathon-state.json

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
